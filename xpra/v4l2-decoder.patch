-def get_min_size(_encoding: str):
+def is_v4l2(decoder: str) -> bool:
+    # stateful V4L2 hardware decoders (ie: "h264parse ! v4l2h264dec" for qcom-iris),
+    # which output NV12 and don't decode frames smaller than 128x128
+    return "v4l2" in decoder
+
+
+def outputs_nv12(decoder: str) -> bool:
+    return decoder.startswith("nv") or is_v4l2(decoder)
+
+
+def parse_min_size(value: str) -> tuple[int, int]:
+    # the hardware's minimum is 128x128; a larger minimum keeps small video regions,
+    # which change size (and so start new decoder sessions) often, on software decoders
+    try:
+        w, h = (int(v) for v in value.lower().split("x", 1))
+    except ValueError:
+        log.warn(f"Warning: invalid XPRA_V4L2_MIN_SIZE {value!r}")
+        w = h = 0
+    return max(128, w), max(128, h)
+
+
+V4L2_MIN_W, V4L2_MIN_H = parse_min_size(os.environ.get("XPRA_V4L2_MIN_SIZE", "128x128"))
+# qcom-iris (Linux 6.18) keeps writing to the buffers of a session stopped while it still
+# has frames in flight (SMMU faults, crashes, corrupted frames in other sessions),
+# so sessions are drained with an EOS first, for at most this long:
+V4L2_DRAIN_TIMEOUT = int(os.environ.get("XPRA_V4L2_DRAIN_TIMEOUT", "500")) / 1000
+
+
+def get_min_size(encoding: str):
+    if is_v4l2(CODECS.get(encoding, "")):
+        return V4L2_MIN_W, V4L2_MIN_H
     return 48, 16
 
 
