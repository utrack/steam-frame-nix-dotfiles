+    def get_desktop_icon_filename(self, class_instance) -> str:
+        index = os.path.join(DESKTOP_ICONS, "index.json")
+        try:
+            mtime = os.stat(index).st_mtime
+            if mtime != self.desktop_icons_mtime:
+                with open(index, encoding="utf8") as f:
+                    self.desktop_icons = json.load(f)
+                self.desktop_icons_mtime = mtime
+        except (OSError, ValueError) as e:
+            log("no desktop icons in %r: %s", index, e)
+            return ""
+        for name in reversed(class_instance):
+            if filename := self.desktop_icons.get(name.lower()):
+                return os.path.join(DESKTOP_ICONS, filename)
+        return ""
+
+    def get_initial_window_icon(self, wid: int, metadata) -> tuple:
+        # the desktop icon for the window class, which then takes precedence over the server's,
+        # or our own until the server sends one
+        class_instance = metadata.strtupleget("class-instance") if DESKTOP_ICONS else ()
+        if filename := self.get_desktop_icon_filename(class_instance):
+            with log.trap_error(f"Error: failed to load desktop icon {filename!r}"):
+                from PIL import Image
+                img = Image.open(filename).convert("RGBA")
+                log("window %#x: desktop icon %r for %s", wid, filename, class_instance)
+                return self.window_icon_image(wid, img.width, img.height, "RGBA", img.tobytes()), True
+        return self.window_icon_image(wid, 0, 0, "default", b""), False
+
