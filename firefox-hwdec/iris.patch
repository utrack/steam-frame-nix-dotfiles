diff --git a/libavcodec/v4l2_context.c b/libavcodec/v4l2_context.c
index e20e3e4..8f4ad84 100644
--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -283,11 +283,18 @@ static inline int v4l2_get_framesize_compressed(V4L2Context* ctx, int width, int
 
 static inline void v4l2_save_to_context(V4L2Context* ctx, struct v4l2_format_update *fmt)
 {
+    V4L2m2mContext * const s = ctx_to_m2mctx(ctx);
     ctx->format.type = ctx->type;
 
     if (fmt->update_avfmt)
         ctx->av_pix_fmt = fmt->av_fmt;
 
+    /* Iris (pre-7.0 kernels) rejects REQBUFS after S_FMT with 0x0 */
+    if (ctx->height == 0 || ctx->width == 0) {
+        ctx->width = s->avctx->width;
+        ctx->height = s->avctx->height;
+    }
+
     if (V4L2_TYPE_IS_MULTIPLANAR(ctx->type)) {
         /* update the sizes to handle the reconfiguration of the capture stream at runtime */
         ctx->format.fmt.pix_mp.height = ctx->height;
@@ -655,7 +662,8 @@ get_qbuf(V4L2Context * const ctx, V4L2Buffer ** const ppavbuf, const int timeout
                 ret = get_event(m);
                 if (ret < 0) {
                     ctx->done = 1;
-                    return ret;
+                    /* Iris: no EOS event queued when draining times out; that is EOF */
+                    return ret == AVERROR(ENOENT) ? AVERROR_EOF : ret;
                 }
             }
             return AVERROR(EAGAIN);
